{
  "name": "openclaw-linq-plugin",
  "version": "1.0.0",
  "description": "Linq iMessage channel plugin for OpenClaw \u2014 real iMessage over API, no Mac required",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "esbuild index.ts setup-entry.ts --bundle --format=esm --platform=node --outdir=dist --external:openclaw --external:openclaw/* --external:node:*",
    "check": "npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linq-team/openclaw-linq-plugin.git"
  },
  "keywords": [
    "openclaw",
    "linq",
    "imessage",
    "channel",
    "plugin",
    "sms",
    "messaging"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.6.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.27.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "linq",
      "label": "Linq",
      "selectionLabel": "Linq (Messaging API)",
      "blurb": "iMessage, RCS, and SMS through the Linq API."
    }
  }
}
